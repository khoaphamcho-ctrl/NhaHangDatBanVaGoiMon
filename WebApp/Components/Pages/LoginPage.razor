@page "/login"
@inject IAuthService AuthService
@inject NavigationManager NavManager

<PageTitle>Đăng Nhập - Nhà Hàng Cố Đô Huế</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden bg-white">
                <!-- HEADER CARD -->
                <div class="p-4 text-center text-white" style="background: linear-gradient(135deg, #7E0E18 0%, #9B111E 100%);">
                    <i class="bi bi-shield-lock-fill fs-1 text-warning mb-2 d-inline-block"></i>
                    <h4 class="fw-bold mb-1">Đăng Nhập Hệ Thống</h4>
                    <p class="small text-light opacity-90 mb-0">Hệ thống Nhà Hàng Cố Đô Huế (Đề tài 11)</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show rounded-3 p-3 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @_errorMessage
                            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small">Tên đăng nhập</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-person text-muted"></i>
                            </span>
                            <input type="text" class="form-control border-start-0 ps-0" @bind="_username" placeholder="admin / staff / khach" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold text-muted small">Mật khẩu</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <i class="bi bi-key text-muted"></i>
                            </span>
                            <input type="password" class="form-control border-start-0 ps-0" @bind="_password" placeholder="••••••" />
                        </div>
                    </div>

                    <button class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm mb-4"
                            disabled="@_isLoggingIn"
                            @onclick="HandleLogin">
                        @if (_isLoggingIn)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Đang kiểm tra tài khoản...</span>
                        }
                        else
                        {
                            <span>ĐĂNG NHẬP</span>
                        }
                    </button>

                    <!-- KHỐI NẠP TÀI KHOẢN MẪU ĐỂ CHẤM ĐIỂM TIÊU CHÍ K4.1 & K4.2 -->
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="fw-bold text-dark small d-block mb-2">
                            <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Tài khoản thử nghiệm nhanh (K4.1):
                        </span>
                        <div class="d-flex flex-column gap-2">
                            <button type="button" class="btn btn-outline-danger btn-sm text-start" @onclick='() => SetAccount("admin", "admin123")'>
                                <strong>Admin (Quản trị):</strong> admin / admin123
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm text-start" @onclick='() => SetAccount("staff", "staff123")'>
                                <strong>Staff (Nhân viên):</strong> staff / staff123
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm text-start" @onclick='() => SetAccount("khach", "khach123")'>
                                <strong>Customer (Khách hàng):</strong> khach / khach123
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _username = "admin";
    private string _password = "admin123";
    private string? _errorMessage;
    private bool _isLoggingIn = false;

    private void SetAccount(string u, string p)
    {
        _username = u;
        _password = p;
        _errorMessage = null;
    }

    private async Task HandleLogin()
    {
        _isLoggingIn = true;
        _errorMessage = null;

        var result = await AuthService.LoginAsync(_username, _password);
        if (result.Success)
        {
            // Điều hướng sang trang quản trị sơ đồ bàn nếu là Admin/Staff, hoặc trang chủ nếu là khách
            if (_username.Equals("admin", StringComparison.OrdinalIgnoreCase) || 
                _username.Equals("staff", StringComparison.OrdinalIgnoreCase))
            {
                NavManager.NavigateTo("admin/tables");
            }
            else
            {
                NavManager.NavigateTo("/");
            }
        }
        else
        {
            _errorMessage = result.ErrorMessage;
        }

        _isLoggingIn = false;
    }
}
