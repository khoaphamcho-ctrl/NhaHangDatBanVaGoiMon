@page "/goi-mon/{TableId:int}"
@inject IViewTablesUseCase ViewTablesUseCase
@inject IViewMenuUseCase ViewMenuUseCase
@inject IViewTableOrderUseCase ViewTableOrderUseCase
@inject ISubmitTableOrderUseCase SubmitTableOrderUseCase
@inject IRestaurantConfigRepository ConfigRepo
@inject ITableCartService CartService
@inject NavigationManager NavManager
@implements IDisposable

<PageTitle>Gọi Món Tại Bàn - Nhà Hàng Cố Đô Huế</PageTitle>

<div class="container py-3 py-md-4">
    <!-- HEADER BÀN ĐANG PHỤC VỤ (RESPONSIVE CHUẨN ĐIỆN THOẠI 390PX: K3.4) -->
    <div class="card border-0 shadow-sm rounded-4 mb-3 bg-white p-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-3">
                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
                    <i class="bi bi-qr-code fs-4"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="fw-bold mb-0 text-dark">@(_table?.TableNumber ?? $"Bàn {TableId}")</h4>
                        <span class="badge @GetTableBadgeClass()">@GetTableStatusText()</span>
                    </div>
                    <small class="text-muted"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@(_table?.Location ?? "Khu vực chính") &bull; Sức chứa: @(_table?.Capacity ?? 4) khách</small>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <!-- Chọn bàn nhanh để demo -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle rounded-pill" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-arrow-left-right me-1"></i> Đổi bàn test (@TableId)
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="max-height: 250px; overflow-y: auto;">
                        @if (_allTables != null)
                        {
                            @foreach (var t in _allTables)
                            {
                                <li>
                                    <a class="dropdown-item @(t.TableId == TableId ? "active fw-bold" : "")" 
                                       href="goi-mon/@t.TableId">
                                        @t.TableNumber (@t.Location)
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </div>
                <a href="ai-assistant" class="btn btn-sm btn-gold rounded-pill px-3 shadow-sm d-flex align-items-center gap-1">
                    <i class="bi bi-robot"></i> AI Gợi ý
                </a>
                @if (_activeOrder != null && _activeOrder.Lines.Any())
                {
                    <a href="thanh-toan/@TableId" class="btn btn-sm btn-success rounded-pill px-3 shadow-sm d-flex align-items-center gap-1 fw-bold">
                        <i class="bi bi-wallet2"></i> Thanh toán
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- HIỂN THỊ BÁO LỖI / THÀNH CÔNG THÂN THIỆN -->
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4 d-flex align-items-start gap-3 p-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-3 text-danger flex-shrink-0"></i>
            <div>
                <h6 class="alert-heading fw-bold mb-1">Không thể gửi yêu cầu gọi món</h6>
                <div>@_errorMessage</div>
            </div>
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4 d-flex align-items-center gap-3 p-3 mb-4" role="alert">
            <i class="bi bi-check2-circle fs-3 text-success flex-shrink-0"></i>
            <div>
                <h6 class="alert-heading fw-bold mb-1">Gửi gọi món thành công!</h6>
                <div>@_successMessage</div>
                <small class="text-muted">Món ăn của quý khách đã được chuyển vào bếp chế biến ngay.</small>
            </div>
            <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
        </div>
    }

    <div class="row g-4">
        <!-- CỘT THỰC ĐƠN CHỌN MÓN (K3.1: MenuItemCardComponent) -->
        <div class="col-lg-7">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-book-half text-primary me-2"></i> Chọn Món Cho Bàn @TableId
                </h5>
                <span class="text-muted small">@(_menuItems?.Count ?? 0) món khả dụng</span>
            </div>

            <!-- Tabs danh mục -->
            <div class="d-flex gap-2 overflow-x-auto pb-2 mb-3">
                <button class="btn btn-sm rounded-pill px-3 @(_activeCategory == null ? "btn-danger fw-bold" : "btn-light border")"
                        @onclick="() => FilterCategory(null)">
                    Tất cả
                </button>
                @if (_categories != null)
                {
                    @foreach (var c in _categories)
                    {
                        <button class="btn btn-sm rounded-pill px-3 text-nowrap @(_activeCategory == c.CategoryId ? "btn-danger fw-bold" : "btn-light border")"
                                @onclick="() => FilterCategory(c.CategoryId)">
                            @c.Name
                        </button>
                    }
                }
            </div>

            @if (_menuItems == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2">Đang tải món ăn...</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var item in GetFilteredItems())
                    {
                        <div class="col-md-6 col-sm-6">
                            <!-- COMPONENT TÁI SỬ DỤNG 2 (K3.1) -->
                            <MenuItemCardComponent Item="item" OnAddToCart="HandleAddToCart" />
                        </div>
                    }
                </div>
            }
        </div>

        <!-- CỘT GIỎ MÓN & ĐƠN HÀNG CỦA BÀN (K3.1: TableOrderSummaryComponent) -->
        <div class="col-lg-5">
            <div class="sticky-top" style="top: 80px;">
                <!-- COMPONENT TÁI SỬ DỤNG 3 (K3.1) -->
                <TableOrderSummaryComponent CartItems="@CartService.GetCartItems(TableId)"
                                            ServiceFeeRate="@_serviceFeeRate"
                                            IsSubmitting="@_isSubmitting"
                                            OnRemoveItem="HandleRemoveCartItem"
                                            OnUpdateQuantity="HandleUpdateCartQuantity"
                                            OnSubmitOrder="HandleSubmitOrder" />

                <!-- HIỂN THỊ CÁC MÓN ĐÃ GỬI BẾP TRƯỚC ĐÓ CỦA BÀN NÀY -->
                @if (_activeOrder != null && _activeOrder.Lines.Any())
                {
                    <div class="card shadow-sm border-0 mt-3 rounded-4 p-3 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-2 border-bottom pb-2">
                            <span class="fw-bold text-dark small">
                                <i class="bi bi-clock-history text-danger me-1"></i> Món đã gọi trước đó (#@_activeOrder.TableOrderId)
                            </span>
                            <span class="badge bg-success">Đang phục vụ</span>
                        </div>
                        <div class="list-group list-group-flush small" style="max-height: 220px; overflow-y: auto;">
                            @foreach (var line in _activeOrder.Lines)
                            {
                                <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold">@line.MenuItemName × @line.Quantity</div>
                                        <div class="text-muted" style="font-size: 0.78rem;">@line.LineTotal.ToString("N0") đ</div>
                                    </div>
                                    <span class="badge @GetLineStatusBadgeClass(line.Status)">
                                        @GetLineStatusText(line.Status)
                                    </span>
                                </div>
                            }
                        </div>
                        <div class="pt-2 border-top mt-2 d-flex justify-content-between fw-bold text-dark small mb-2">
                            <span>Tổng đơn hiện tại:</span>
                            <span class="text-danger fs-6">@_activeOrder.TotalAmount.ToString("N0") đ</span>
                        </div>

                        <a href="thanh-toan/@TableId" class="btn btn-success w-100 rounded-pill py-2 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-credit-card-2-back-fill"></i>
                            <span>Xem Hóa Đơn & Thanh Toán</span>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int TableId { get; set; }

    private DiningTable? _table;
    private List<DiningTable>? _allTables;
    private List<MenuCategory>? _categories;
    private List<MenuItem>? _menuItems;
    private int? _activeCategory;
    private TableOrder? _activeOrder;
    private decimal _serviceFeeRate = 5;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isSubmitting = false;

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += OnCartChanged;
        _serviceFeeRate = await ConfigRepo.GetServiceFeeRateAsync();
    }

    private void OnCartChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CartService.OnChange -= OnCartChanged;
    }

    private async Task LoadData()
    {
        _errorMessage = null;
        _table = await ViewTablesUseCase.ExecuteAsync(TableId);
        var tables = await ViewTablesUseCase.ExecuteAsync();
        _allTables = tables.ToList();

        _categories = (await ViewMenuUseCase.GetCategoriesAsync()).ToList();
        var items = await ViewMenuUseCase.GetMenuItemsAsync();
        _menuItems = items.ToList();

        _activeOrder = await ViewTableOrderUseCase.GetActiveOrderByTableIdAsync(TableId);
    }

    private IEnumerable<MenuItem> GetFilteredItems()
    {
        if (_menuItems == null) return Enumerable.Empty<MenuItem>();
        if (_activeCategory.HasValue)
        {
            return _menuItems.Where(i => i.CategoryId == _activeCategory.Value);
        }
        return _menuItems;
    }

    private void FilterCategory(int? id) => _activeCategory = id;

    private void HandleAddToCart((MenuItem item, int quantity, string note) args)
    {
        _errorMessage = null;
        try
        {
            // THỰC THI KIỂM TRA LUẬT 2.2: Không thêm món đã hết
            TableOrderBusinessRules.ValidateMenuItemAvailable(args.item);
            CartService.AddItem(TableId, args.item, args.quantity, args.note);
        }
        catch (DomainException dex)
        {
            _errorMessage = dex.Message;
        }
    }

    private void HandleRemoveCartItem(int menuItemId)
    {
        CartService.RemoveItem(TableId, menuItemId);
    }

    private void HandleUpdateCartQuantity((int menuItemId, int quantity) args)
    {
        CartService.UpdateQuantity(TableId, args.menuItemId, args.quantity);
    }

    // Nạp Demo Vi phạm gọi món đã hết (Luật 2.2)
    private void LoadUnavailableItemDemo()
    {
        _errorMessage = null;
        _successMessage = null;
        var unavailableItem = _menuItems?.FirstOrDefault(i => !i.IsAvailable);
        if (unavailableItem != null)
        {
            try
            {
                // Thử thêm món hết hàng vào giỏ
                TableOrderBusinessRules.ValidateMenuItemAvailable(unavailableItem);
            }
            catch (DomainException dex)
            {
                // Bắt lỗi vi phạm Luật 2.2 hiển thị thân thiện (K3.3)
                _errorMessage = dex.Message;
            }
        }
        else
        {
            _errorMessage = "Không tìm thấy món hết hàng trong menu mẫu để demo.";
        }
    }

    // Nạp Demo Vi phạm gọi món cho bàn đã đóng (Luật 2.1 & 2.4)
    private void LoadOrderForPaidTableDemo()
    {
        _errorMessage = null;
        _successMessage = null;
        try
        {
            var fakePaidOrder = new TableOrder
            {
                TableOrderId = 999,
                TableNumber = _table?.TableNumber ?? $"Bàn {TableId}",
                Status = OrderStatus.Paid // Đã thanh toán
            };
            TableOrderBusinessRules.ValidateCanOrderForTable(_table ?? new DiningTable(), fakePaidOrder);
        }
        catch (DomainException dex)
        {
            _errorMessage = dex.Message;
        }
    }

    // Nạp Combo món hợp lệ
    private void LoadValidMealDemo()
    {
        _errorMessage = null;
        _successMessage = null;
        CartService.ClearCart(TableId);

        var bunBo = _menuItems?.FirstOrDefault(i => i.Name.Contains("Bún Bò"));
        var banhBeo = _menuItems?.FirstOrDefault(i => i.Name.Contains("Bánh Bèo"));
        var tra = _menuItems?.FirstOrDefault(i => i.Name.Contains("Trà Cung Đình"));

        if (bunBo != null) CartService.AddItem(TableId, bunBo, 2, "1 tô ít cay, 1 tô bình thường");
        if (banhBeo != null) CartService.AddItem(TableId, banhBeo, 1, "Thêm tóp mỡ giòn");
        if (tra != null) CartService.AddItem(TableId, tra, 1, "Uống ấm");

        _successMessage = $"Đã nạp combo món Huế đặc sắc vào giỏ của {_table?.TableNumber}. Bạn có thể bấm 'Gửi Gọi Món Vào Bếp'!";
    }

    private async Task HandleSubmitOrder()
    {
        _isSubmitting = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            // THỰC THI USECASE GỌI MÓN (CÀI ĐẶT LUẬT 2: K1.3 & TRANSACTION: K2.2)
            int orderId = await SubmitTableOrderUseCase.ExecuteAsync(TableId, "Khách gọi món trực tuyến tại bàn");
            _successMessage = $"Phiếu gọi món #{orderId} đã được chuyển tới bếp thành công! Bếp đang tiến hành chuẩn bị các món cho {_table?.TableNumber}.";

            // Cập nhật lại dữ liệu đơn hàng và bàn
            await LoadData();
        }
        catch (DomainException dex)
        {
            // BẪY LỖI NGHIỆP VỤ THÂN THIỆN (K3.3)
            _errorMessage = dex.Message;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Lỗi xử lý đơn gọi món: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private string GetTableBadgeClass() => _table?.Status switch
    {
        TableStatus.Available => "bg-success",
        TableStatus.Occupied => "bg-danger",
        TableStatus.Reserved => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    private string GetTableStatusText() => _table?.Status switch
    {
        TableStatus.Available => "Bàn trống",
        TableStatus.Occupied => "Đang có khách",
        TableStatus.Reserved => "Đã đặt trước",
        _ => "Không xác định"
    };

    private string GetLineStatusBadgeClass(OrderLineStatus status) => status switch
    {
        OrderLineStatus.SentToKitchen => "bg-secondary text-white",
        OrderLineStatus.Cooking => "bg-warning text-dark",
        OrderLineStatus.Served => "bg-success text-white",
        _ => "bg-light text-dark"
    };

    private string GetLineStatusText(OrderLineStatus status) => status switch
    {
        OrderLineStatus.SentToKitchen => "Đã gửi bếp",
        OrderLineStatus.Cooking => "Đang nấu",
        OrderLineStatus.Served => "Đã phục vụ",
        _ => "Chờ"
    };
}
