@page "/admin/tables"
@attribute [Authorize(Roles = "Admin,Staff")]
@inject IViewTablesUseCase ViewTablesUseCase
@inject IDiningTableRepository TableRepo
@inject NavigationManager NavManager

<PageTitle>Quản Lý Sơ Đồ Bàn - Quản Trị Nhà Hàng</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4 border-bottom pb-3">
        <div>
            <span class="badge bg-danger text-white px-3 py-2 rounded-pill fw-bold text-uppercase">
                <i class="bi bi-shield-shaded me-1"></i> Phân Hệ Quản Trị
            </span>
            <h2 class="fw-bold mt-2 mb-1">Sơ Đồ Bàn Ăn (Floor Plan)</h2>
            <p class="text-muted mb-0">Theo dõi trạng thái trực quan các bàn trong nhà hàng (Trống / Có khách / Đã đặt trước)</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a href="admin/orders" class="btn btn-primary rounded-pill px-3 py-2 d-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-receipt"></i>
                <span>Xem Đơn & Thu Ngân</span>
            </a>
        </div>
    </div>

    <!-- TỔNG QUAN TRẠNG THÁI -->
    @if (_tables != null)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4 col-12">
                <div class="card p-3 rounded-4 border-0 shadow-sm bg-success bg-opacity-10 text-success d-flex flex-row align-items-center gap-3">
                    <i class="bi bi-check-circle-fill fs-1"></i>
                    <div>
                        <h4 class="fw-bold mb-0">@_tables.Count(t => t.Status == TableStatus.Available)</h4>
                        <small class="fw-semibold">Bàn Trống (Khả dụng)</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-12">
                <div class="card p-3 rounded-4 border-0 shadow-sm bg-danger bg-opacity-10 text-danger d-flex flex-row align-items-center gap-3">
                    <i class="bi bi-person-fill-exclamation fs-1"></i>
                    <div>
                        <h4 class="fw-bold mb-0">@_tables.Count(t => t.Status == TableStatus.Occupied)</h4>
                        <small class="fw-semibold">Đang Phục Vụ / Đang Ăn</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-12">
                <div class="card p-3 rounded-4 border-0 shadow-sm bg-warning bg-opacity-10 text-warning d-flex flex-row align-items-center gap-3">
                    <i class="bi bi-calendar2-event-fill fs-1"></i>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">@_tables.Count(t => t.Status == TableStatus.Reserved)</h4>
                        <small class="fw-semibold text-dark">Đã Có Khách Đặt Trước</small>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- SƠ ĐỒ BÀN HIỂN THỊ DƯỚI DẠNG CARD -->
    @if (_tables == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status"></div>
            <p class="text-muted mt-2">Đang tải sơ đồ bàn...</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var table in _tables)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 shadow-sm border-2 rounded-4 p-3 bg-white @GetBorderClass(table.Status)">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="fw-bold text-dark mb-0">@table.TableNumber</h5>
                                <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@table.Location</small>
                            </div>
                            <span class="badge @GetBadgeClass(table.Status) px-3 py-2 rounded-pill">
                                @GetStatusText(table.Status)
                            </span>
                        </div>

                        <div class="p-2 bg-light rounded-3 my-2 small text-muted">
                            <i class="bi bi-people-fill me-1"></i> Sức chứa: <strong>@table.Capacity người</strong>
                            @if (!string.IsNullOrWhiteSpace(table.Description))
                            {
                                <div class="mt-1 fst-italic">@table.Description</div>
                            }
                        </div>

                        <!-- THAO TÁC QUẢN TRỊ TRÊN BÀN -->
                        <div class="mt-3 pt-2 border-top d-flex flex-wrap gap-2 justify-content-between">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-success @(table.Status == TableStatus.Available ? "active" : "")"
                                        title="Đặt về trạng thái Trống"
                                        @onclick="() => ChangeStatus(table.TableId, TableStatus.Available)">
                                    Trống
                                </button>
                                <button class="btn btn-outline-danger @(table.Status == TableStatus.Occupied ? "active" : "")"
                                        title="Chuyển sang Đang ăn"
                                        @onclick="() => ChangeStatus(table.TableId, TableStatus.Occupied)">
                                    Đang ăn
                                </button>
                                <button class="btn btn-outline-warning text-dark @(table.Status == TableStatus.Reserved ? "active" : "")"
                                        title="Chuyển sang Đã đặt"
                                        @onclick="() => ChangeStatus(table.TableId, TableStatus.Reserved)">
                                    Đã đặt
                                </button>
                            </div>

                            <a href="goi-mon/@table.TableId" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Mở trang gọi món bàn này">
                                <i class="bi bi-qr-code me-1"></i> Gọi món
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<DiningTable>? _tables;

    protected override async Task OnInitializedAsync()
    {
        await LoadTables();
    }

    private async Task LoadTables()
    {
        var result = await ViewTablesUseCase.ExecuteAsync();
        _tables = result.ToList();
    }

    private async Task ChangeStatus(int tableId, TableStatus newStatus)
    {
        await TableRepo.UpdateTableStatusAsync(tableId, newStatus);
        await LoadTables();
    }

    private string GetBorderClass(TableStatus status) => status switch
    {
        TableStatus.Available => "border-success-subtle",
        TableStatus.Occupied => "border-danger",
        TableStatus.Reserved => "border-warning",
        _ => "border-light"
    };

    private string GetBadgeClass(TableStatus status) => status switch
    {
        TableStatus.Available => "bg-success text-white",
        TableStatus.Occupied => "bg-danger text-white",
        TableStatus.Reserved => "bg-warning text-dark",
        _ => "bg-secondary text-white"
    };

    private string GetStatusText(TableStatus status) => status switch
    {
        TableStatus.Available => "Bàn trống",
        TableStatus.Occupied => "Đang phục vụ",
        TableStatus.Reserved => "Đã đặt trước",
        _ => "Chưa xác định"
    };
}
