@page "/admin/orders"
@attribute [Authorize(Roles = "Admin,Staff")]
@inject IViewTableOrderUseCase ViewOrderUseCase
@inject ICloseTableOrderUseCase CloseTableOrderUseCase
@inject IUpdateOrderLineStatusUseCase UpdateLineStatusUseCase
@inject NavigationManager NavManager

<PageTitle>Quản Lý Đơn Gọi Món & Thu Ngân - Quản Trị</PageTitle>

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4 border-bottom pb-3">
        <div>
            <span class="badge bg-danger text-white px-3 py-2 rounded-pill fw-bold text-uppercase">
                <i class="bi bi-receipt me-1"></i> Điều Phối Bếp & Thu Ngân
            </span>
            <h2 class="fw-bold mt-2 mb-1">Quản Lý Đơn Bàn & Thanh Toán</h2>
            <p class="text-muted mb-0">Cập nhật tiến độ chế biến của bếp, tính tiền tự động kèm phí dịch vụ và đóng bàn</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-secondary rounded-pill px-3" @onclick="LoadOrders">
                <i class="bi bi-arrow-clockwise me-1"></i> Làm mới danh sách
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @_message
            <button type="button" class="btn-close" @onclick="() => _message = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @_errorMessage
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    @if (_orders == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-danger" role="status"></div>
            <p class="text-muted mt-2">Đang tải danh sách đơn gọi món...</p>
        </div>
    }
    else if (!_orders.Any())
    {
        <div class="card p-5 text-center border-0 shadow-sm rounded-4 bg-white">
            <i class="bi bi-journal-x fs-1 text-muted opacity-50 mb-3"></i>
            <h5 class="fw-bold text-dark">Chưa có đơn gọi món nào</h5>
            <p class="text-muted mb-3">Hãy vào một bàn ăn bất kỳ để gọi món thử nghiệm.</p>
            <div>
                <a href="goi-mon/1" class="btn btn-primary rounded-pill px-4">
                    Tới bàn gọi món ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var order in _orders)
            {
                <div class="col-lg-6 col-12">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden bg-white">
                        <!-- HEADER ĐƠN BÀN -->
                        <div class="p-3 d-flex justify-content-between align-items-center border-bottom @(order.Status == OrderStatus.Open ? "bg-primary-subtle" : "bg-light")">
                            <div>
                                <h5 class="fw-bold mb-0 text-dark">
                                    <i class="bi bi-displayport-fill text-primary me-1"></i> @order.TableNumber
                                </h5>
                                <small class="text-muted">Đơn #@order.TableOrderId &bull; @order.OrderTime.ToString("HH:mm dd/MM/yyyy")</small>
                            </div>
                            <span class="badge @GetOrderStatusBadge(order.Status) px-3 py-2 rounded-pill">
                                @GetOrderStatusText(order.Status)
                            </span>
                        </div>

                        <!-- DANH SÁCH CÁC MÓN CỦA BÀN -->
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-muted small text-uppercase mb-2">Tiến độ món ăn trong bếp:</h6>
                            <div class="list-group list-group-flush mb-3" style="max-height: 250px; overflow-y: auto;">
                                @foreach (var line in order.Lines)
                                {
                                    <div class="list-group-item px-0 py-2 border-bottom">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <div class="fw-semibold text-dark">@line.MenuItemName × @line.Quantity</div>
                                                <div class="text-muted small">@line.LineTotal.ToString("N0") đ</div>
                                                @if (!string.IsNullOrWhiteSpace(line.SpecialInstructions))
                                                {
                                                    <span class="badge bg-light text-secondary border small">
                                                        <i class="bi bi-info-circle me-1"></i>@line.SpecialInstructions
                                                    </span>
                                                }
                                            </div>

                                            <!-- NÚT CHUYỂN TRẠNG THÁI TIẾN ĐỘ BẾP -->
                                            <div class="d-flex align-items-center gap-1">
                                                @if (order.Status == OrderStatus.Open)
                                                {
                                                    <select class="form-select form-select-sm" 
                                                            style="width: 130px; font-size: 0.8rem;"
                                                            value="@((int)line.Status)"
                                                            @onchange="(e) => ChangeLineStatus(line.TableOrderLineId, e.Value?.ToString())">
                                                        <option value="0">Đã gửi bếp</option>
                                                        <option value="1">Đang nấu</option>
                                                        <option value="2">Đã phục vụ</option>
                                                    </select>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success-subtle text-success">Đã phục vụ</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- CHI TIẾT TÍNH TIỀN HÓA ĐƠN THEO LUẬT 2.3 -->
                            <div class="bg-light p-3 rounded-3 mb-3 border">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Tạm tính tiền món:</span>
                                    <span class="fw-semibold">@order.SubTotal.ToString("N0") đ</span>
                                </div>
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>Phí phục vụ (@order.ServiceFeeRate%):</span>
                                    <span class="fw-semibold text-info">+@order.ServiceFeeAmount.ToString("N0") đ</span>
                                </div>
                                <hr class="my-1" />
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <span class="fw-bold text-dark">Tổng cộng thanh toán:</span>
                                    <span class="fw-bold text-danger fs-5">@order.TotalAmount.ToString("N0") đ</span>
                                </div>
                            </div>

                            <!-- THAO TÁC THU NGÂN -->
                            <div class="d-flex gap-2">
                                @if (order.Status == OrderStatus.Open)
                                {
                                    <button class="btn btn-success flex-grow-1 rounded-pill py-2 fw-semibold shadow-sm"
                                            @onclick="() => CloseAndPayOrder(order.TableOrderId)">
                                        <i class="bi bi-cash-stack me-1"></i> Thanh Toán & Đóng Bàn
                                    </button>
                                    <a href="thanh-toan/@order.DiningTableId" class="btn btn-outline-success rounded-pill px-3 py-2" title="Thu ngân bàn với VietQR / Voucher">
                                        <i class="bi bi-qr-code me-1"></i> QR / Thu Ngân
                                    </a>
                                }
                                <a href="admin/bill/@order.TableOrderId" class="btn btn-outline-secondary rounded-pill px-3 py-2" target="_blank" title="In hóa đơn">
                                    <i class="bi bi-printer me-1"></i> In Bill
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<TableOrder>? _orders;
    private string? _message;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        var result = await ViewOrderUseCase.GetAllOrdersAsync();
        _orders = result.ToList();
    }

    private async Task ChangeLineStatus(int lineId, string? statusStr)
    {
        if (int.TryParse(statusStr, out int st))
        {
            await UpdateLineStatusUseCase.ExecuteAsync(lineId, (OrderLineStatus)st);
            _message = "Đã cập nhật tiến độ món ăn trong bếp.";
            await LoadOrders();
        }
    }

    private async Task CloseAndPayOrder(int orderId)
    {
        _errorMessage = null;
        _message = null;
        try
        {
            // THỰC THI USECASE ĐÓNG BÀN & THANH TOÁN (LUẬT 2: K1.3)
            await CloseTableOrderUseCase.ExecuteAsync(orderId);
            _message = $"Đã thanh toán thành công đơn #{orderId} và giải phóng bàn về trạng thái Trống (Available)!";
            await LoadOrders();
        }
        catch (DomainException dex)
        {
            _errorMessage = dex.Message;
        }
    }

    private string GetOrderStatusBadge(OrderStatus status) => status switch
    {
        OrderStatus.Open => "bg-danger text-white",
        OrderStatus.Paid => "bg-success text-white",
        OrderStatus.Cancelled => "bg-secondary text-white",
        _ => "bg-light text-dark"
    };

    private string GetOrderStatusText(OrderStatus status) => status switch
    {
        OrderStatus.Open => "Đang mở / Phục vụ",
        OrderStatus.Paid => "Đã thanh toán & Đóng bàn",
        OrderStatus.Cancelled => "Đã hủy",
        _ => "Không rõ"
    };
}
