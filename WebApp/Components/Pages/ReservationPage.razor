    private string GetStatusBadge(ReservationStatus status) => status switch
    {
        ReservationStatus.Confirmed => "bg-success text-white",
        ReservationStatus.Cancelled => "bg-danger text-white",
        ReservationStatus.Completed => "bg-secondary text-white",
        _ => "bg-info text-white"
    };

    private string GetStatusText(ReservationStatus status) => status switch
    {
        ReservationStatus.Confirmed => "Đã xác nhận",
        ReservationStatus.Cancelled => "Đã hủy",
        ReservationStatus.Completed => "Đã phục vụ",
        _ => "Chờ xác nhận"
    };
