@page "/dat-ban"
@using System.ComponentModel.DataAnnotations
@inject IViewTablesUseCase ViewTablesUseCase
@inject IPlaceReservationUseCase PlaceReservationUseCase

<PageTitle>Đặt Bàn Trực Tuyến - Nhà Hàng Cố Đô Huế</PageTitle>

<div class="container py-4">
    <!-- TIÊU ĐỀ & MÔ TẢ -->
    <div class="text-center mb-4">
        <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill fw-bold text-uppercase">
            <i class="bi bi-calendar2-heart-fill me-1"></i> Trải Nghiệm Ẩm Thực Cung Đình
        </span>
        <h2 class="fw-bold mt-2 mb-1">Đặt Bàn Trước Trực Tuyến</h2>
        <p class="text-muted">Chọn không gian ưng ý, thời gian và số lượng khách. Hệ thống tự động kiểm tra chỗ trống và sức chứa.</p>
    </div>

    <!-- KHỐI BẢNG THÔNG BÁO DEMO VẤN ĐÁP LUẬT 1 (K1.3, K3.3) -->
    <div class="card border-warning bg-warning bg-opacity-10 mb-4 shadow-sm" style="border-radius: 16px;">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-shield-check text-warning fs-5"></i>
                    <span>Trọng Tâm Vấn Đáp: Tiêu Chí K1.3 & K3.3 (Luật 1: Ràng Buộc Đặt Bàn)</span>
                </h6>
                <span class="badge bg-dark">CoreBusiness / UseCases</span>
            </div>
            <p class="small text-muted mb-3">
                Luật 1 quy định: <strong>(1) Số khách đặt &le; Sức chứa của bàn</strong> và <strong>(2) Một bàn không có 2 đặt chỗ trùng nhau trong khung 2 giờ</strong>.
                Bấm các nút dưới đây để nạp nhanh kịch bản kiểm tra:
            </p>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill fw-semibold" @onclick="LoadOverCapacityDemo">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Demo Vi Phạm: Vượt sức chứa bàn (6 khách vào bàn 2 chỗ)
                </button>
                <button type="button" class="btn btn-outline-warning btn-sm rounded-pill fw-semibold text-dark" @onclick="LoadOverlapTimeDemo">
                    <i class="bi bi-clock-history me-1"></i> Demo Vi Phạm: Trùng lịch 2 giờ (Đặt 19:00 trùng ca 18:00)
                </button>
                <button type="button" class="btn btn-outline-success btn-sm rounded-pill fw-semibold" @onclick="LoadValidDemo">
                    <i class="bi bi-check-circle-fill me-1"></i> Nạp Ca Đặt Bàn Hợp Lệ
                </button>
            </div>
        </div>
    </div>

    <!-- HIỂN THỊ THÔNG BÁO LỖI / THÀNH CÔNG THÂN THIỆN (K3.3) -->
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4 d-flex align-items-start gap-3 p-3 mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill fs-3 text-danger flex-shrink-0"></i>
            <div>
                <h6 class="alert-heading fw-bold mb-1">Quy định nghiệp vụ bị vi phạm!</h6>
                <div>@_errorMessage</div>
                <small class="text-muted d-block mt-1">Được chặn an toàn bởi tầng Domain Rule trong CoreBusiness / UseCases (Tiêu chí K1.3, K3.3).</small>
            </div>
            <button type="button" class="btn-close" @onclick="() => _errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4 d-flex align-items-center gap-3 p-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-3 text-success flex-shrink-0"></i>
            <div>
                <h6 class="alert-heading fw-bold mb-1">Đặt bàn thành công!</h6>
                <div>@_successMessage</div>
            </div>
            <button type="button" class="btn-close" @onclick="() => _successMessage = null"></button>
        </div>
    }

    <div class="row g-4">
        <!-- FORM ĐẶT BÀN (K3.2: EditForm + DataAnnotations) -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 p-4 rounded-4 bg-white sticky-top" style="top: 80px;">
                <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
                    <i class="bi bi-person-lines-fill text-primary me-2"></i> Thông Tin Đặt Chỗ
                </h5>

                <EditForm Model="@_formModel" OnValidSubmit="HandleReservationSubmit">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Bàn được chọn:</label>
                        <div class="p-2 border rounded-3 bg-light d-flex justify-content-between align-items-center">
                            @if (_selectedTable != null)
                            {
                                <div>
                                    <strong class="text-primary">@_selectedTable.TableNumber</strong>
                                    <span class="text-muted small"> (@_selectedTable.Location - Sức chứa: @_selectedTable.Capacity người)</span>
                                </div>
                                <span class="badge bg-success">Đã chọn</span>
                            }
                            else
                            {
                                <span class="text-danger small fst-italic">Vui lòng chọn 1 bàn từ sơ đồ bên phải</span>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Họ và tên khách hàng *</label>
                        <InputText class="form-control" @bind-Value="_formModel.CustomerName" placeholder="Nguyễn Văn A" />
                        <ValidationMessage For="@(() => _formModel.CustomerName)" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Số điện thoại liên hệ *</label>
                        <InputText class="form-control" @bind-Value="_formModel.PhoneNumber" placeholder="0905xxxxxx" />
                        <ValidationMessage For="@(() => _formModel.PhoneNumber)" class="text-danger small mt-1" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-7">
                            <label class="form-label fw-semibold small text-muted">Thời gian đến *</label>
                            <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_formModel.ReservationTime" />
                            <ValidationMessage For="@(() => _formModel.ReservationTime)" class="text-danger small mt-1" />
                        </div>
                        <div class="col-5">
                            <label class="form-label fw-semibold small text-muted">Số lượng khách *</label>
                            <InputNumber class="form-control" @bind-Value="_formModel.GuestCount" min="1" max="50" />
                            <ValidationMessage For="@(() => _formModel.GuestCount)" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-muted">Ghi chú đặc biệt (Tùy chọn)</label>
                        <InputTextArea class="form-control" @bind-Value="_formModel.Note" rows="2" placeholder="Ví dụ: Kỷ niệm sinh nhật, ghế em bé, bàn view đẹp..." />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2"
                            disabled="@(_isSubmitting || _selectedTable == null)">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span>Đang kiểm tra nghiệp vụ & ghi nhận...</span>
                        }
                        else
                        {
                            <i class="bi bi-calendar-check-fill"></i>
                            <span>Xác Nhận Đặt Bàn Ngay</span>
                        }
                    </button>
                </EditForm>
            </div>
        </div>

        <!-- SƠ ĐỒ BÀN (K3.1: TableCardComponent) -->
        <div class="col-lg-7">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i> Sơ Đồ Bàn Trực Quan (Floor Plan)
                </h5>
                <span class="text-muted small">Bấm vào bàn để chọn</span>
            </div>

            @if (_tables == null)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2">Đang tải danh sách bàn...</p>
                </div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var table in _tables)
                    {
                        <div class="col-md-6">
                            <!-- SỬ DỤNG COMPONENT TÁI SỬ DỤNG 1 (K3.1) -->
                            <TableCardComponent Table="table" 
                                                IsSelected="@(_selectedTable?.TableId == table.TableId)"
                                                OnTableSelected="HandleTableSelected" />
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<DiningTable>? _tables;
    private DiningTable? _selectedTable;
    private ReservationFormModel _formModel = new();
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isSubmitting = false;

    public class ReservationFormModel
    {
        [Required(ErrorMessage = "Vui lòng nhập họ và tên của bạn.")]
        [StringLength(100, MinimumLength = 2, ErrorMessage = "Tên khách hàng từ 2 đến 100 ký tự.")]
        public string CustomerName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng nhập số điện thoại liên hệ.")]
        [Phone(ErrorMessage = "Số điện thoại không đúng định dạng.")]
        public string PhoneNumber { get; set; } = string.Empty;

        [Required(ErrorMessage = "Vui lòng chọn thời gian đến.")]
        public DateTime ReservationTime { get; set; } = DateTime.Today.AddHours(18);

        [Required(ErrorMessage = "Vui lòng nhập số lượng khách.")]
        [Range(1, 50, ErrorMessage = "Số lượng khách từ 1 đến 50 người.")]
        public int GuestCount { get; set; } = 2;

        public string Note { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadTables();
    }

    private async Task LoadTables()
    {
        var result = await ViewTablesUseCase.ExecuteAsync();
        _tables = result.ToList();
        if (_tables.Any() && _selectedTable == null)
        {
            _selectedTable = _tables.First();
        }
    }

    private void HandleTableSelected(DiningTable table)
    {
        _selectedTable = table;
        _errorMessage = null;
    }

    // Nạp kịch bản vi phạm sức chứa (Luật 1.1)
    private void LoadOverCapacityDemo()
    {
        _errorMessage = null;
        _successMessage = null;
        // Chọn Bàn 01 (Sức chứa 2 người)
        _selectedTable = _tables?.FirstOrDefault(t => t.TableId == 1) ?? _tables?.FirstOrDefault();
        _formModel.CustomerName = "Đoàn Khách Thử Nghiệm";
        _formModel.PhoneNumber = "0905999888";
        _formModel.GuestCount = 6; // 6 người > 2 ghế => Vi phạm Luật 1.1!
        _formModel.ReservationTime = DateTime.Today.AddHours(20);
        _formModel.Note = "Thử nghiệm ca vi phạm vượt quá sức chứa";
    }

    // Nạp kịch bản vi phạm trùng khung 2 giờ (Luật 1.2)
    private void LoadOverlapTimeDemo()
    {
        _errorMessage = null;
        _successMessage = null;
        // Bàn 01 đã có khách lúc 18:00
        _selectedTable = _tables?.FirstOrDefault(t => t.TableId == 1) ?? _tables?.FirstOrDefault();
        _formModel.CustomerName = "Khách Hàng Đặt Trùng Lịch";
        _formModel.PhoneNumber = "0912345678";
        _formModel.GuestCount = 2; // Số khách hợp lệ (2 <= 2)
        _formModel.ReservationTime = DateTime.Today.AddHours(19); // 19:00 cách 18:00 chỉ 1 giờ => Vi phạm khoảng cách 2 giờ!
        _formModel.Note = "Thử nghiệm ca vi phạm trùng khung 2 giờ";
    }

    // Nạp kịch bản hợp lệ
    private void LoadValidDemo()
    {
        _errorMessage = null;
        _successMessage = null;
        _selectedTable = _tables?.FirstOrDefault(t => t.TableId == 4); // Bàn 04 (6 chỗ)
        _formModel.CustomerName = "Gia đình anh Tuấn";
        _formModel.PhoneNumber = "0987654321";
        _formModel.GuestCount = 4; // 4 <= 6
        _formModel.ReservationTime = DateTime.Today.AddDays(1).AddHours(18).AddMinutes(30); // 18:30 ngày mai
        _formModel.Note = "Ăn tối gia đình";
    }

    private async Task HandleReservationSubmit()
    {
        if (_selectedTable == null)
        {
            _errorMessage = "Vui lòng chọn 1 bàn ăn trên sơ đồ.";
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var reservation = new Reservation
            {
                DiningTableId = _selectedTable.TableId,
                CustomerName = _formModel.CustomerName.Trim(),
                PhoneNumber = _formModel.PhoneNumber.Trim(),
                ReservationTime = _formModel.ReservationTime,
                GuestCount = _formModel.GuestCount,
                Note = _formModel.Note
            };

            // THỰC THI USECASE ĐẶT BÀN (CÀI ĐẶT LUẬT 1: K1.3)
            int reservationId = await PlaceReservationUseCase.ExecuteAsync(reservation);

            _successMessage = $"Chúc mừng {_formModel.CustomerName}! Bàn '{_selectedTable.TableNumber}' đã được đặt thành công vào lúc {_formModel.ReservationTime:HH:mm dd/MM/yyyy} (Mã đặt bàn: #{reservationId}).";
            
            // Tải lại danh sách bàn để cập nhật trạng thái mới
            await LoadTables();
        }
        catch (DomainException dex)
        {
            // BẪY LỖI NGHIỆP VỤ THÂN THIỆN (K3.3)
            _errorMessage = dex.Message;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Đã xảy ra lỗi hệ thống: {ex.Message}";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
