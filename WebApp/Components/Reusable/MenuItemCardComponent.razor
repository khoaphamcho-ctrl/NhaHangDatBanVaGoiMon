@using CoreBusiness.Models

<div class="card h-100 shadow-sm border-0 overflow-hidden" style="border-radius: 16px; transition: transform 0.2s, box-shadow 0.2s;">
    <div class="position-relative" style="height: 190px; overflow: hidden; background-color: #f8f9fa;">
        <img src="@Item.ImageUrl" 
             alt="@Item.Name" 
             class="w-100 h-100 object-fit-cover" 
             loading="lazy" 
             onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600&auto=format&fit=crop'" />
        
        <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75 backdrop-blur rounded-pill">
            @Item.CategoryName
        </span>

        @if (!Item.IsAvailable)
        {
            <div class="position-absolute top-0 end-0 m-2 badge bg-danger text-white rounded-pill px-2 py-1 shadow-sm">
                <i class="bi bi-x-circle me-1"></i> Tạm hết hàng
            </div>
        }
    </div>

    <div class="card-body d-flex flex-column justify-content-between p-3">
        <div>
            <div class="d-flex justify-content-between align-items-baseline mb-1">
                <h6 class="card-title fw-bold text-dark mb-0 fs-6" title="@Item.Name">
                    @Item.Name
                </h6>
            </div>
            
            <p class="text-muted small mb-2 line-clamp-2" style="font-size: 0.82rem; min-height: 2.4rem;">
                @Item.Description
            </p>
        </div>

        <div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="fw-bold text-primary fs-5">
                    @Item.Price.ToString("N0") <span class="fs-6 fw-normal text-muted">đ/@Item.Unit</span>
                </div>
            </div>

            @if (Item.IsAvailable)
            {
                <div class="d-flex align-items-center gap-2">
                    <div class="input-group input-group-sm" style="max-width: 105px;">
                        <button class="btn btn-outline-secondary" type="button" @onclick="Decrement" disabled="@(_quantity <= 1)">
                            <i class="bi bi-dash"></i>
                        </button>
                        <input type="text" class="form-control text-center fw-semibold px-1" value="@_quantity" readonly />
                        <button class="btn btn-outline-secondary" type="button" @onclick="Increment">
                            <i class="bi bi-plus"></i>
                        </button>
                    </div>

                    <button class="btn btn-primary btn-sm flex-grow-1 rounded-pill d-flex align-items-center justify-content-center gap-1 shadow-sm"
                            @onclick="HandleAddToCart">
                        <i class="bi bi-cart-plus-fill"></i>
                        <span>Thêm</span>
                    </button>
                </div>
            }
            else
            {
                <button class="btn btn-secondary btn-sm w-100 rounded-pill" disabled>
                    <i class="bi bi-slash-circle me-1"></i> Tạm ngưng phục vụ
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public MenuItem Item { get; set; } = default!;

    [Parameter]
    public EventCallback<(MenuItem item, int quantity, string note)> OnAddToCart { get; set; }

    private int _quantity = 1;

    private void Increment() => _quantity++;
    private void Decrement()
    {
        if (_quantity > 1) _quantity--;
    }

    private async Task HandleAddToCart()
    {
        if (OnAddToCart.HasDelegate && Item.IsAvailable)
        {
            await OnAddToCart.InvokeAsync((Item, _quantity, string.Empty));
            _quantity = 1; // Reset số lượng sau khi thêm
        }
    }
}
