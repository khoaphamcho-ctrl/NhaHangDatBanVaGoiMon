@using CoreBusiness.Models
@using CoreBusiness.Enums

<div class="card h-100 shadow-sm border-2 transition-all @(IsDisabled ? "opacity-75 bg-light" : "") @(IsSelected ? "border-primary bg-primary bg-opacity-10 shadow" : "border-light-subtle")"
     style="border-radius: 14px; transition: transform 0.2s, box-shadow 0.2s; cursor: @(IsDisabled ? "not-allowed" : "pointer");"
     @onclick="HandleClick">
    <div class="card-body d-flex flex-column justify-content-between p-3">
        <div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="card-title fw-bold mb-0 @(IsSelected ? "text-primary" : "text-dark")">
                    <i class="bi bi-displayport text-primary me-1"></i> @Table.TableNumber
                </h5>
                @if (!string.IsNullOrEmpty(CustomBadgeText))
                {
                    <span class="badge @(CustomBadgeClass ?? "bg-secondary") rounded-pill px-2 py-1">
                        @CustomBadgeText
                    </span>
                }
                else
                {
                    <span class="badge @GetStatusBadgeClass() rounded-pill px-2 py-1">
                        @GetStatusText()
                    </span>
                }
            </div>
            
            <p class="text-muted small mb-2">
                <i class="bi bi-geo-alt-fill text-danger me-1"></i> @Table.Location
            </p>

            <div class="d-inline-flex align-items-center bg-light px-2 py-1 rounded-pill mb-2 border">
                <i class="bi bi-people-fill text-secondary me-1"></i>
                <span class="small fw-semibold text-secondary">Sức chứa: @Table.Capacity người</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Table.Description))
            {
                <p class="card-text text-secondary small fst-italic mb-0" style="font-size: 0.85rem;">
                    @Table.Description
                </p>
            }

            @if (!string.IsNullOrEmpty(DisabledReason))
            {
                <div class="alert alert-warning py-1 px-2 mt-2 mb-0 small rounded-3 border-0" style="font-size: 0.78rem;">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @DisabledReason
                </div>
            }
        </div>

        @if (ShowQuickAction)
        {
            <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                <button class="btn btn-sm @(IsSelected ? "btn-primary" : (IsDisabled ? "btn-outline-secondary disabled" : "btn-outline-primary")) w-100 rounded-pill fw-semibold"
                        disabled="@IsDisabled"
                        @onclick:stopPropagation="true"
                        @onclick="HandleClick">
                    <i class="bi @(IsSelected ? "bi-check-circle-fill" : (IsDisabled ? "bi-slash-circle" : "bi-hand-index-thumb")) me-1"></i>
                    @(IsSelected ? "Đã chọn bàn này" : (IsDisabled ? "Không khả dụng" : "Chọn bàn này"))
                </button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public DiningTable Table { get; set; } = default!;

    [Parameter]
    public bool IsSelected { get; set; } = false;

    [Parameter]
    public bool ShowQuickAction { get; set; } = true;

    [Parameter]
    public bool IsDisabled { get; set; } = false;

    [Parameter]
    public string? DisabledReason { get; set; }

    [Parameter]
    public string? CustomBadgeText { get; set; }

    [Parameter]
    public string? CustomBadgeClass { get; set; }

    [Parameter]
    public EventCallback<DiningTable> OnSelectTable { get; set; }

    [Parameter]
    public EventCallback<DiningTable> OnTableSelected { get; set; }

    private async Task HandleClick()
    {
        if (!IsDisabled)
        {
            if (OnSelectTable.HasDelegate)
            {
                await OnSelectTable.InvokeAsync(Table);
            }
            if (OnTableSelected.HasDelegate)
            {
                await OnTableSelected.InvokeAsync(Table);
            }
        }
    }

    private string GetStatusBadgeClass() => Table.Status switch
    {
        TableStatus.Available => "bg-success text-white",
        TableStatus.Occupied => "bg-danger text-white",
        TableStatus.Reserved => "bg-warning text-dark",
        _ => "bg-secondary text-white"
    };

    private string GetStatusText() => Table.Status switch
    {
        TableStatus.Available => "Bàn trống",
        TableStatus.Occupied => "Đang phục vụ",
        TableStatus.Reserved => "Đã đặt trước",
        _ => "Không xác định"
    };
}
